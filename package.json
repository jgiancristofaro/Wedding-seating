{
  "name": "wedding-seating",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Visual wedding seating chart planner with link-based sharing",
  "scripts": {
    "start": "npm install && vite",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:sql": "bash supabase/test/run.sh",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "idb-keyval": "^6.3.0",
    "immer": "^10.2.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.58.0",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4",
    "react": "19.1",
    "react-dom": "19.1",
    "three": "^0.180.0",
    "write-excel-file": "^2.3.10",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.1",
    "@types/react-dom": "19.1",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "tailwindcss": "3.4",
    "typescript": "5.9",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  }
}
